# CampusCart Environment Variables
# Copy this file to .env and fill in real values for local testing.

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campuscart?retryWrites=true&w=majority

# JWT Secret for session authentication (generate a strong random string)
JWT_SECRET=super_secret_campuscart_jwt_key_change_in_production

# Node Environment
NODE_ENV=development

# Optional: Port for local testing server
PORT=3000

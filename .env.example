# CampusCart Environment Variables
# Copy this file to .env and fill in real values for local development.

# MongoDB Atlas Connection URI (Replace with your actual Atlas cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campuscart?retryWrites=true&w=majority

# JWT Secret for session authentication (Use a strong, 32+ character random string in production)
JWT_SECRET=super_secret_campuscart_jwt_key_change_in_production

# Configurable Allowed University Email Domains
# Comma-separated list of allowed domains. Leave blank or '*' to accept any valid email format during initial testing.
ALLOWED_EMAIL_DOMAINS=rvu.edu.in,student.rvu.edu.in

# Environment (development | production)
NODE_ENV=development

# Optional: Port for local testing server
PORT=3000
HOST=0.0.0.0
